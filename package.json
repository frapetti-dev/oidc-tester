{
	"name": "oidc-tester",
	"private": true,
	"license": "MIT",
	"version": "0.2.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm tauri:dev",
		"build": "pnpm tauri:build",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"spec:check": "node scripts/spec-coverage.ts",
		"licenses:gen": "node scripts/licenses.ts",
		"test:unit": "vitest run",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:e2e:web": "playwright test --project=web",
		"test:e2e:native": "playwright test --project=native",
		"mock-idp": "node tests/mock-idp/server.ts",
		"test": "pnpm test:unit && pnpm test:rust && pnpm spec:check",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/svelte-vite": "^10.6.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"selfsigned": "^5.5.0",
		"storybook": "^10.6.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-language-server": "^0.18.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"typescript-language-server": "^6.0.1",
		"undici": "^8.12.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@lucide/svelte": "^1.52.0",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "~2.8.1",
		"@tauri-apps/plugin-opener": "~2.7.0",
		"jose": "^6.2.12",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
