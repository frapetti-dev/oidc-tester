{
	"name": "oidc-tester",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"spec:check": "node scripts/spec-coverage.ts",
		"test:unit": "vitest run",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:e2e:web": "playwright test --project=web",
		"test:e2e:native": "playwright test --project=native",
		"mock-idp": "node tests/mock-idp/server.ts",
		"test": "pnpm test:unit && pnpm test:rust && pnpm spec:check",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"selfsigned": "^5.5.0",
		"storybook": "^10.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-language-server": "^0.18.4",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"typescript-language-server": "^6.0.1",
		"undici": "^8.11.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "~2.8.1",
		"@tauri-apps/plugin-opener": "~2.7.0",
		"jose": "^6.2.12",
		"zod": "^4.6.5"
	}
}
