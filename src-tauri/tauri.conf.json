{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "OIDC Tester",
	"version": "0.2.1",
	"identifier": "dev.oidctester.app",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm vite:dev",
		"beforeBuildCommand": "pnpm vite:build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "OIDC Tester",
				"width": 1440,
				"height": 900,
				"minWidth": 720,
				"minHeight": 520,
				"resizable": true,
				"fullscreen": false,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
